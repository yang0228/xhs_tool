# DeepSeek API (Anthropic-compatible)
ANTHROPIC_API_KEY=sk-你的deepseek-api-key
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
AI_MODEL_DEFAULT=deepseek-chat

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://xhs:xhs_dev@localhost:5432/xhs_tool

# Cloudflare R2 (image storage)
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=xhs-images
R2_PUBLIC_URL=

# Backend
SECRET_KEY=change-me-to-a-random-string
DEBUG=true
